<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install-helper.sh fills in the placeholders and writes ~/Library/LaunchAgents/__LABEL__.plist.
     The helper (ingest/helper.py) listens on 127.0.0.1:47321 only, starts at login and is restarted if it stops. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-I</string>
    <string>__APP_DIR__/ingest/helper.py</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>
  <key>StandardOutPath</key>
  <string>__APP_DIR__/ingest/logs/helper.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_DIR__/ingest/logs/helper.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
