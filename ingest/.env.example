# Kopier til ingest/.env (git-ignorert) og fyll inn. Aldri commit .env.
# Ditt eget PRIVATE GitHub-repo som appen synker kvitteringer fra (sync.sh nekter offentlige repoer).
MATKASSA_DATA_REPO=brukernavn/matkassa-data
# REMA-innlogging: kjør `rema auth login` (rema1000-cli), så leses tokenet fra ~/.rema1000/tokens.json.
# Bare hvis du ikke bruker rema1000-cli:
REMA_FIREBASE_REFRESH_TOKEN=
REMA_PHONE=
REMA_DEVICE_ID=
